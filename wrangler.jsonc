{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://khushpreet.dev"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "khushbrar605@gmail.com"
    }
  ],
  "routes": [
    {
      "pattern": "khushpreet.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.khushpreet.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}